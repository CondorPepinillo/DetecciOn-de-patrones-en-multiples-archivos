    if (newMatch != null) {
      if (negative) return false;
      //else
      mymatch.assignFrom(newMatch);
      return true;
    }
    else { // no match
      if (negative)
        return next(input, mymatch);
      //else
      return false;
    }
  }

    void dump(StringBuffer os) {
	os.append("(?");
	os.append(negative ? '!' : '=');
	re.dumpAll(os);
	os.append(')');
    }
}

