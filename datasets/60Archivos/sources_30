 * A server socket that allows clients to connect via the SSL protocol.
 */
public abstract class SSLServerSocket extends ServerSocket
{

  // Constructors.
  // -------------------------------------------------------------------------

  protected SSLServerSocket() throws IOException
  {
    super();
    //super(0);
