  // Cloneable interface.
  // ------------------------------------------------------------------------

  public Object clone()
  {
    try
      {
        return super.clone();
      }
    catch (CloneNotSupportedException cnse)
      {
        throw new InternalError(cnse.getMessage());
      }
  }

  // Abstract methods.
  // ------------------------------------------------------------------------

  /**
   * Initialize this PKIXCertPathChecker. If subclasses support forward
   * checking, a value of true can be passed to this method, and
