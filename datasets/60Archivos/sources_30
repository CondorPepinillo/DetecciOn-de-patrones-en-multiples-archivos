   * @see #end
   * @see #group
   */
  public boolean matches ()
  {
    if (lookingAt())
      {
	if (position == input.length())
	  return true;
	match = null;
      }
    return false;
  }
  
  /**
   * Returns the Pattern that is interpreted by this Matcher
