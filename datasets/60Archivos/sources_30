   * <code>defaultChoice</code> does not fall within the array boundary of
   * <code>choices</code>.
   */
  public RealmChoiceCallback(String prompt, String[] choices, int defaultChoice,
                             boolean multiple)
  {
    super(prompt, choices, defaultChoice, multiple);
  }
