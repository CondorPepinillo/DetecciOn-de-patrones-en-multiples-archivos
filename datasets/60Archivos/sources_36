memcpy (void *d, const void *s, size_t n)
{
  TEST_ABORT;
  return my_memcpy (d, s, n);
}

void
bcopy (const void *s, void *d, size_t n)
{
  TEST_ABORT;
  my_bcopy (s, d, n);
}

