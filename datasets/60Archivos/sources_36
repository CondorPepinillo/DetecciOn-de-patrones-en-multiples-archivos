/* MVBITS copies LEN bits starting at bit position FROMPOS from FROM
   into TO, starting at bit position TOPOS.  */

extern void SUB_NAME (const TYPE *, const GFC_INTEGER_4 *,
		      const GFC_INTEGER_4 *, TYPE *, const GFC_INTEGER_4 *);
