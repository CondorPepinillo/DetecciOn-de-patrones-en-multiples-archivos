	  o = &convert_optab_table[i];
	  h = &o->handlers[j][k];
	  if (h->libfunc)
	    {
	      if (GET_CODE (h->libfunc) != SYMBOL_REF)
		abort ();
	      fprintf (stderr, "%s\t%s\t%s:\t%s\n",
		       GET_RTX_NAME (o->code),
		       GET_MODE_NAME (j),
		       GET_MODE_NAME (k),
		       XSTR (h->libfunc, 0));
	    }
	}
}

