#ifndef HAVE_DUP2
static int
dup2 (int oldfd, int newfd)
{
  int fdtmp[256];
  int fdx = 0;
  int fd;

  if (oldfd == newfd)
    return oldfd;
  close (newfd);
  while ((fd = dup (oldfd)) != newfd && fd >= 0) /* good enough for low fd's */
    fdtmp[fdx++] = fd;
  while (fdx > 0)
    close (fdtmp[--fdx]);

  return fd;
}
