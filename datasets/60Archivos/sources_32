{
  if (sqrt(x)*sqrt(x) != x)
    link_error ();

  if (sqrt(x)*sqrt(y) != sqrt(x*y))
    link_error ();

  if (exp(x)*exp(y) != exp(x+y))
    link_error ();

  if (pow(x,y)*pow(z,y) != pow(z*x,y))
    link_error ();

  if (pow(x,y)*pow(x,z) != pow(x,y+z))
    link_error ();

  if (x/exp(y) != x*exp(-y))
    link_error ();

  if (x/pow(y,z) != x*pow(y,-z))
    link_error ();
}

