df_rd_transfer_function (int bb ATTRIBUTE_UNUSED, int *changed, void *in,
			 void *out, void *gen, void *kill,
			 void *data ATTRIBUTE_UNUSED)
{
  *changed = bitmap_ior_and_compl (out, gen, in, kill);
}


static void
