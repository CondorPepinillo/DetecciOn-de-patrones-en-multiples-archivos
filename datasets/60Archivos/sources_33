etime_ (GFC_REAL_4 *t)
{
  gfc_array_r4 desc;
  GFC_REAL_4 val;

  /* We only fill in the fields that are used in etime_sub.  */
  desc.dim[0].lbound = 0;
  desc.dim[0].ubound = 1;
  desc.dim[0].stride = 1;
  desc.data = t;

  etime_sub (&desc, &val);
  return val;
}
