  CP_DUMMY_TREE_CODE = LAST_C_TREE_CODE,
#include "cp-tree.def"
  LAST_CPLUS_TREE_CODE
};
#undef DEFTREECODE

#define cp_stmt_codes					\
   CTOR_INITIALIZER,	TRY_BLOCK,	HANDLER,	\
