		_Bit_type * __q = this->_M_allocate(__len);
		iterator __i = std::copy(begin(), __position,
					 iterator(__q, 0));
		__i = std::copy(__first, __last, __i);
		this->_M_impl._M_finish = std::copy(__position, end(), __i);
		this->_M_deallocate();
