      // string end.
      void
      _M_update_egptr()
      {
	const bool __testin = this->_M_mode & ios_base::in;

	if (this->pptr() && this->pptr() > this->egptr())
	  if (__testin)
	    this->setg(this->eback(), this->gptr(), this->pptr());
	  else
	    this->setg(this->pptr(), this->pptr(), this->pptr());
      }
