struct State {
    int p0, p1, p2;
    inline State(){p0=0;p1=0;p2=0;}
    inline State(const State &s) {
	p0 = s.p0;
	p1 = s.p1;
	p2 = s.p2;
    }
    
    inline void operator =(const State &s) {
	p0 = s.p0;
	p1 = s.p1;
	p2 = s.p2;
    }
    
    inline void step(void) {
	p0 = p1+p2;
	p1 = p0*p1+p2;
	p2 = p0-p2;
    }
};


