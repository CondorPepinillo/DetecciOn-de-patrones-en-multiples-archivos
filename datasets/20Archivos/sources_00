static inline HvLpDma_Rc HvCallEvent_dmaToSp(void* local, u32 remote,
		u32 length, HvLpDma_Direction dir)
{
	u64 abs_addr;
	HvLpDma_Rc retVal;

	abs_addr = virt_to_abs(local);
