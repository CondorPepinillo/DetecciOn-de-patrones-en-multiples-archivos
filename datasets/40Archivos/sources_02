{
	u8 msg[2] = { reg, val };
	struct i2c_msg msgs;
	
	msgs.flags = 0;
	msgs.addr = id / 2;
	msgs.len = 2;
	msgs.buf = msg;
	return i2c_transfer(&av7110->i2c_adap, &msgs, 1);
}

