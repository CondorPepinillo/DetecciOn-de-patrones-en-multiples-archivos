	.name		= "amba",
	.match		= amba_match,
	.hotplug	= amba_hotplug,
	.suspend	= amba_suspend,
	.resume		= amba_resume,
};

static int __init amba_init(void)
{
	return bus_register(&amba_bustype);
}

