		0x7f, 0xff,	/* PTD7 */
		0xff, 0xfe,	/* PTE0 */
		0xff, 0xfd,	/* PTE1 */
		0xff, 0xf7,	/* PTE3 */
		0xff, 0xbf,	/* PTE6 */
		0xff, 0x7f,	/* PTE7 */
	}, *t=matrix_switch;

	for(i=0; i<8; i++) {
		ctrl_outb(*t++, PDDR);
		ctrl_outb(*t++, PEDR);
		*s++=ctrl_inb(PCDR);
		*s++=ctrl_inb(PFDR);
	}

	ctrl_outb(0xff, PDDR);
	ctrl_outb(0xff, PEDR);

	*s++=ctrl_inb(PGDR);
	*s++=ctrl_inb(PHDR);

	return 0;
}


void __init hp600_kbd_init_hw(void)
{
	scan_kbd_init();

	if (MACH_HP620)
		register_scan_keyboard(hp620_japanese_scan_kbd,
				       hp620_japanese_table, 18);
	else if (MACH_HP680 || MACH_HP690) 
		register_scan_keyboard(hp680_japanese_scan_kbd,
				       hp680_japanese_table, 18);

	printk(KERN_INFO "HP600 matrix scan keyboard registered\n");
}

