static int __init init (void)
{
	int	retval;

	if (usb_disabled ())
		return -ENODEV;
	if ((retval = dummy_pdev_detect ()) != 0)
		return retval;
	if ((retval = dummy_probe (&the_pdev.dev)) != 0)
		dummy_pdev_remove ();
	return retval;
}
module_init (init);

static void __exit cleanup (void)
{
	dummy_remove (&the_pdev.dev);
	dummy_pdev_remove ();
}
module_exit (cleanup);
