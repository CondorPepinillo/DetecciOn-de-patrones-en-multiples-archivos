static int
mpc52xx_uart_request_port(struct uart_port *port)
{
	if (port->flags & UPF_IOREMAP) /* Need to remap ? */
		port->membase = ioremap(port->mapbase, sizeof(struct mpc52xx_psc));
	
	return port->membase != NULL ? 0 : -EBUSY;
}

