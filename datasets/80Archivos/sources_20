static int sa1100fb_suspend(struct device *dev, u32 state, u32 level)
{
	struct sa1100fb_info *fbi = dev_get_drvdata(dev);

	if (level == SUSPEND_DISABLE || level == SUSPEND_POWER_DOWN)
		set_ctrlr_state(fbi, C_DISABLE_PM);
	return 0;
}

