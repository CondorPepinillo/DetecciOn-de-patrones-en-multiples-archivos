STATIC int
init_inodecache( void )
{
	linvfs_inode_zone = kmem_cache_create("linvfs_icache",
				sizeof(vnode_t), 0, SLAB_RECLAIM_ACCOUNT,
				init_once, NULL);
	if (linvfs_inode_zone == NULL)
		return -ENOMEM;
