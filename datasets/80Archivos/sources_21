struct serpent_ctx {
	u8 iv[SERPENT_BLOCK_SIZE];
	u32 expkey[SERPENT_EXPKEY_WORDS];
};


static int serpent_setkey(void *ctx, const u8 *key, unsigned int keylen, u32 *flags)
{
