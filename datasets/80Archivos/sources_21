static int set_modem_status(sdla_t *card, unsigned char data)
{
	CHDLC_MAILBOX_STRUCT *mb = card->mbox;
	int err;

	mb->buffer_length=1;
	mb->command=SET_MODEM_STATUS;
	mb->data[0]=data;
	err = sdla_exec(mb) ? mb->return_code : CMD_TIMEOUT;
	if (err != COMMAND_OK) 
		chdlc_error (card, err, mb);
	
	return err;
}

