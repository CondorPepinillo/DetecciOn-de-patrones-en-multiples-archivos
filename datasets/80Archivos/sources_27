   *
   * @return the number of entries
   */
  public int size()
  {
    return actionMap.size();
  }

  /**
   * Clears the <code>ActionMap</code>.
   */
  public void clear()
  {
    actionMap.clear();
  }

  /**
   * Returns all keys of entries in this <code>ActionMap</code>.
