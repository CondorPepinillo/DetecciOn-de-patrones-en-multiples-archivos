	if (unregister_blkdev( ACSI_MAJOR, "ad" ) != 0)
		printk( KERN_ERR "acsi: cleanup_module failed\n");

	for (i = 0; i < NDevices; i++) {
		del_gendisk(acsi_gendisk[i]);
		put_disk(acsi_gendisk[i]);
	}
}
