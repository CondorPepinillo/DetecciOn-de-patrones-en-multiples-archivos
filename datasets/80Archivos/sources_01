		    rec_reg_l, rec_pola_l, rec_pos_l,					 \
		 reg_r, pola_r, pos_r, len_r, mute_reg_r, mute_pola_r, mute_pos_r,	 \
		    rec_reg_r, rec_pola_r, rec_pos_r)					 \
	[name] = {{reg_l, pola_l, pos_l, len_l, mute_reg_l, mute_pola_l, mute_pos_l,	 \
		    rec_reg_l, rec_pola_l, rec_pos_l},					 \
		  {reg_r, pola_r, pos_r, len_r, mute_reg_r, mute_pola_r, mute_pos_r,	 \
		    rec_reg_r, rec_pola_r, rec_pos_r}}

