		printk(KERN_INFO "function nest level (%d) < 0\n", ftape_function_nest_level);
		ftape_function_nest_level = 0;
	}
	if (ftape_function_nest_level < sizeof(spacing)) {
		indent = (spacing + 
			  sizeof(spacing) - 1 - 
