#ifndef CONFIG_FT_NO_TRACE_AT_ALL
	{ "tracing",   &ftape_tracing,     3,              ft_t_bug, ft_t_any},
#endif
	{ "ioport",    &ft_fdc_base,       CONFIG_FT_FDC_BASE,     0x0, 0xfff},
