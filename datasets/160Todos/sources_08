				   const char *buf, size_t count, int nr, int reg)
{
	/* bits 0, 2..7 reserved => mask with 0x02 */  
	unsigned long v = simple_strtoul(buf, NULL, 10) & 0x02;
	data->watchdog[1] &= ~v;

	fscher_write_value(client, reg, v);
	return count;
}

