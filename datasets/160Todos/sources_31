    throws NoSuchObjectException 
  {
    if (obj instanceof RemoteObject)
      {
	deleteStub(obj);
	UnicastServerRef sref = (UnicastServerRef)((RemoteObject)obj).getRef();
	return sref.unexportObject(obj, force);
      }
    else
      {
	//FIX ME
	;
      }
    return true;
  }

}
