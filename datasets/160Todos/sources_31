  void								\
  zero_init_section ()						\
  {								\
    static int zero_init_count = 1;				\
								\
    if (in_section != in_zero_init)				\
      {								\
        fprintf (asm_out_file, "\tAREA |C$$zidata%d|,NOINIT\n",	\
	         zero_init_count++);				\
