   */
  int IP_MULTICAST_IF2 = 0x1F; // 31

  /**
   * This option enables or disables local loopback of multicast datagrams.
   * @since 1.4
   */
  int IP_MULTICAST_LOOP = 0x12; // 18

  /**
   * This option sets the type-of-service or traffic class field in the
