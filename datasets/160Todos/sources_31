    protected CoderResult decodeLoop (ByteBuffer in, CharBuffer out)
    {
      // TODO: Optimize this in the case in.hasArray() / out.hasArray()
      while (in.hasRemaining ())
        {
          byte b = in.get ();

          if (b < 0)
            {
              in.position (in.position () - 1);
