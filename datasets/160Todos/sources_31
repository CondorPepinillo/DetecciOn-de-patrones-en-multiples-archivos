  Rectangle clipBounds;
    
  XFontMetrics metrics;


  public Object clone()
  {
    try
      {
	XGraphics gfxCopy = (XGraphics) super.clone();
	gfxCopy.context = context.create();
	
	return gfxCopy;
      }
    catch (CloneNotSupportedException ex)
      {
	// This should never happen.
	throw new InternalError ();
      }
