void
check ()
{
  int diff1, diff2;

  diff1 = diff2 = 0;

#define CHECK(X) \
	(diff1 |= (__MRDACC (X) ^ (X | 0x100)), \
	 diff2 |= (__MRDACCG (X) ^ X))
  CHECK (0);
  CHECK (1);
  CHECK (2);
  CHECK (3);
#if defined (__CPU_FR450__)
  CHECK (8);
  CHECK (9);
  CHECK (10);
  CHECK (11);
#elif __FRV_ACC__ > 4
  CHECK (4);
  CHECK (5);
  CHECK (6);
  CHECK (7);
#endif
#undef CHECK
  if ((diff1 | diff2) != 0)
    abort ();
}

