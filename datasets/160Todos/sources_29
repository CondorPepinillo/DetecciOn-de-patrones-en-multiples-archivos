  {
    return inputTypes;
  }

  public boolean isOwnReader(ImageReader reader)
  {
    if (reader == null)
      throw new IllegalArgumentException("reader may not be null");
    
    return pluginClassName.equals(reader.getClass().getName());
  }
}
