  {
    try
      {
        listener.error(new TransformerException(e));
      }
    catch (TransformerException e2)
      {
        throw new SAXException(e2);
      }
  }
  
  public void fatalError(SAXParseException e)
    throws SAXException
  {
    try
      {
        listener.fatalError(new TransformerException(e));
      }
    catch (TransformerException e2)
      {
        throw new SAXException(e2);
      }
  }
  
}
