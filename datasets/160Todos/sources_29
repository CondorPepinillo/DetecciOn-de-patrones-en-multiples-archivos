 {
     private static int first (int x, int y)
     {
         return x;
     }

     public static void main (String[] args)
     {
         int l = args.length;

         /* This should print:
 0
 0
 1
         */
         System.out.println (l);
         System.out.println (first (l, ++l));
         System.out.println (l);
     }
 }

