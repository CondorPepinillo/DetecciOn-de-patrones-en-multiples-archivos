	    if (myalign == LEFT)
	      x = ins.left + hgap;
	    else if (myalign == CENTER)
	      x = ins.left + (d.width - new_w) / 2 + hgap;
	    else
	      x = ins.left + (d.width - new_w) + hgap;

	    for (int k = i; k < j; ++k)
	      {
		if (comps[k].visible)
