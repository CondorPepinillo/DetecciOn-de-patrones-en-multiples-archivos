   * subclasses. The old style (bitmask 0x3f) should not be mixed with the
   * new style (bitmasks 0xffffffc0).
   *
   * @see #getModifiers()
   * @see MouseEvent
   * @serial the modifier state, stored in the new style
   */
  int modifiers;

  /**
