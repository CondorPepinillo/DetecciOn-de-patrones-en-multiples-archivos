    if (path != null)
      {
	 Rectangle rect = getPathBounds(path);

	 if ((rect != null) && rect.contains(x, y))
	   return path;
      }

    return null;
  }

  public int getRowForLocation(int x, int y)
  {
    TreePath path = getPathForLocation(x, y);

    if (path != null)
      return getRowForPath(path);

