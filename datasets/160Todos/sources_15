	.charset	= "cp1251",
	.uni2char	= uni2char,
	.char2uni	= char2uni,
	.charset2lower	= charset2lower,
	.charset2upper	= charset2upper,
	.owner		= THIS_MODULE,
};

static int __init init_nls_cp1251(void)
{
	return register_nls(&table);
}

static void __exit exit_nls_cp1251(void)
{
	unregister_nls(&table);
}

