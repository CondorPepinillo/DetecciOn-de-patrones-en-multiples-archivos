static inline int neo2200_sync(struct fb_info *info)
{
	struct neofb_par *par = (struct neofb_par *) info->par;
	int waitcycles;

	while (readl(&par->neo2200->bltStat) & 1)
		waitcycles++;
	return 0;
}

