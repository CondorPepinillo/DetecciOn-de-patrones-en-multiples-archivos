struct acpi_thread_state *
acpi_ut_create_thread_state (
	void)
{
	union acpi_generic_state        *state;


	ACPI_FUNCTION_TRACE ("ut_create_thread_state");


	/* Create the generic state object */

	state = acpi_ut_create_generic_state ();
	if (!state) {
		return_PTR (NULL);
