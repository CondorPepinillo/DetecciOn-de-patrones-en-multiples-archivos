	{ 0, BASE_BAUD, 0, XPAR_INTC_0_UARTNS550_##num##_VEC_ID,	 \
		ASYNC_BOOT_AUTOCONF,		 			 \
		.iomem_base = (u8 *)XPAR_UARTNS550_##num##_BASEADDR + 3, \
		.iomem_reg_shift = 2,					 \
		.io_type = SERIAL_IO_MEM},

