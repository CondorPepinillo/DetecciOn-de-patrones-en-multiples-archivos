#include <sys/mman.h>

int switcheroo(int fd, int prot, void *from, void *to, int size)
{
	if(munmap(to, size) < 0){
		return(-1);
	}
	if(mmap(to, size, prot,	MAP_SHARED | MAP_FIXED, fd, 0) != to){
		return(-1);
	}
	if(munmap(from, size) < 0){
		return(-1);
	}
	return(0);
}

