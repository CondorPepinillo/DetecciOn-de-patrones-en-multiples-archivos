	printk(KERN_NOTICE "sq: Registering store queue API.\n");

#ifdef CONFIG_PROC_FS
	create_proc_read_entry("sq_mapping", 0, 0, sq_mapping_read_proc, 0);
#endif

	return misc_register(&sq_dev);
}

