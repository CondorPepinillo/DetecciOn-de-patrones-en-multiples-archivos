static irqreturn_t
titan_intr_nop(int irq, void *dev_id, struct pt_regs *regs)                    
{
      /*
       * This is a NOP interrupt handler for the purposes of
       * event counting -- just return.
       */                                                                     
       return IRQ_HANDLED;
