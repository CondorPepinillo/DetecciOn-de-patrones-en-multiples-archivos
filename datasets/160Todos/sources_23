/*
 * This strdup() is used for creating copies of network 
 * device names to be handed over to sysctl.
 */
 
char *net_sysctl_strdup(const char *s)
{
	char *rv = kmalloc(strlen(s)+1, GFP_KERNEL);
	if (rv)
		strcpy(rv, s);
	return rv;
}

