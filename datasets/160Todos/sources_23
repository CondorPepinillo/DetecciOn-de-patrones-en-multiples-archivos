 */
static __inline void 
sym_set_cam_status(struct scsi_cmnd *ccb, int status)
{
	ccb->result &= ~(0xff  << 16);
	ccb->result |= (status << 16);
}

/*
 *  Get the status field of a CAM CCB.
 */
static __inline int 
sym_get_cam_status(struct scsi_cmnd *ccb)
{
	return ((ccb->result >> 16) & 0xff);
}

