static void sticon_putcs(struct vc_data *conp, const unsigned short *s,
			 int count, int ypos, int xpos)
{
    int unit = conp->vc_num;
    int redraw_cursor = 0;

    if (vga_is_gfx || console_blanked)
	    return;

    if (vt_cons[unit]->vc_mode != KD_TEXT)
