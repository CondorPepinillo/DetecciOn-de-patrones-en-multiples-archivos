	IRDA_DEBUG(4, "%s()\n", __FUNCTION__);

	ASSERT(userdata != NULL, return -1;);

	/* Make room for MUX header */
	ASSERT(skb_headroom(userdata) >= LMP_HEADER, return -1;);
