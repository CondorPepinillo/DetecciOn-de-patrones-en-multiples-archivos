	graphics.drawRect(x, y, width, height);
	sleep(debugFlashTime);
	
	graphics.setColor(debugFlashColor);
	graphics.drawRect(x, y, width, height);
	sleep(debugFlashTime);
      }

    graphics.setColor(color);
    graphics.drawRect(x, y, width, height);
  }

