    if (resourceName.startsWith("/"))
      return resourceName.substring(1);

    Class c = this;
    while (c.isArray())
      c = c.getComponentType();

    String packageName = c.getName().replace('.', '/');
    int end = packageName.lastIndexOf('/');
    if (end != -1)
      return packageName.substring(0, end + 1) + resourceName;
    return resourceName;
