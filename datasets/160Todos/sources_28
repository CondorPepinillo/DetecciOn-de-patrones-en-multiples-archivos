  public void installUI(JComponent c)
  {
    super.installUI(c);
    if (c instanceof JLabel)
      {
	JLabel l = (JLabel) c;

	installComponents(l);
	installDefaults(l);
	installListeners(l);
	installKeyboardActions(l);
      }
  }

