  public void uninstallUI(JComponent c)
  {
    super.uninstallUI(c);
    if (c instanceof JLabel)
      {
	JLabel l = (JLabel) c;

	uninstallKeyboardActions(l);
	uninstallListeners(l);
	uninstallDefaults(l);
	uninstallComponents(l);
      }
  }

