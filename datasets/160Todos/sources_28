  {
    int p = position();
    char result = ByteBufferHelper.getChar(bb, (p << 1) + offset, endian);
    position(p + 1);
    return result;
  }

  /**
   * Absolute get method. Reads the <code>char</code> at position
   * <code>index</code>.
