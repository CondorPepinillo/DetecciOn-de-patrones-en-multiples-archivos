  }

  /**
   * Create an exception with a message and chain it to the exception
   * which occurred while loading the class.
   *
   * @param s the message
   * @param ex the chained exception
   * @since 1.2
   */
  public ClassNotFoundException(String s, Throwable ex)
  {
