	if (!request_region(I8042_DATA_REG, 16, "i8042"))
		return -1;
#endif

        i8042_reset = 1;

#if defined(CONFIG_PPC64)
	if (check_legacy_ioport(I8042_DATA_REG))
		return -1;
	if (!request_region(I8042_DATA_REG, 16, "i8042"))
		return -1;
#endif
	return 0;
}

