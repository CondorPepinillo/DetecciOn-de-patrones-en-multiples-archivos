{
	if (register_chrdev(IDETAPE_MAJOR, "ht", &idetape_fops)) {
		printk(KERN_ERR "ide-tape: Failed to register character device interface\n");
		return -EBUSY;
	}
	ide_register_driver(&idetape_driver);
	return 0;
}

