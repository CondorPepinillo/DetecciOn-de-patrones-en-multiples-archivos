     case Panel_1280x768_2: {  /* LVDS only */
        static const UCHAR nonscalingmodes[] = {
	   SIS_RI_720x480, SIS_RI_720x576, SIS_RI_768x576, SIS_RI_800x480, SIS_RI_848x480,
