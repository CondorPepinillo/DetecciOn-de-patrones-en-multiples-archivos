		      lswi    6,7,0x8         \n\
		      mr      %0,6"
		      : "=r" (kbd_status) :: "6", "7");

	__raw_writel(0x00000000, 0xff50000c);
	eieio();

	return (unsigned char)(kbd_status >> 24);
}

