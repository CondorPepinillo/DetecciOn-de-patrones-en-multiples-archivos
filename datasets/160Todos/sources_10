     case Panel_Custom:     SiS_Pr->PanelXRes = SiS_Pr->CP_MaxX;
    			    SiS_Pr->PanelYRes = SiS_Pr->CP_MaxY;
			    SiS_Pr->PanelHT   = SiS_Pr->CHTotal;
			    SiS_Pr->PanelVT   = SiS_Pr->CVTotal;
