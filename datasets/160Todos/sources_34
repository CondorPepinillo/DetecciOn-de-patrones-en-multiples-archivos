         FLOAT (*pos) (FLOAT, FLOAT, FLOAT, FLOAT), 
	 FLOAT (*neg) (FLOAT, FLOAT, FLOAT, FLOAT))
{
  if (((*pos)(x, y, 1.0, 2.0) == 1.0) != expected)
