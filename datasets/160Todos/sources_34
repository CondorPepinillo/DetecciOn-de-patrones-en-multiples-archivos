static jint
keysym_to_awt_keycode (GdkEvent *event)
{
  guint ukeyval;
  guint state;

  ukeyval = get_first_keyval_from_keymap (event);
  state = event->key.state;

  /* VK_A through VK_Z */
  if (ukeyval >= GDK_A && ukeyval <= GDK_Z)
    return ukeyval;

  /* VK_0 through VK_9 */
  if (ukeyval >= GDK_0 && ukeyval <= GDK_9)
    return ukeyval;

  switch (ukeyval)
    {
    case GDK_Return:
    case GDK_KP_Enter:
      return VK_ENTER;
