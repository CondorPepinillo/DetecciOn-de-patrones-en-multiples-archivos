template<int N,int I,int J,int K>
inline double SineSeries()
{
  const double x=I*2*M_PI/N;
  const bool go=K+1!=J;
  return 1.0-x*x/(2*K+2)/(2*K+3)*SineSeries<N*go,I*go,J*go,(K+1)*go>();
}

