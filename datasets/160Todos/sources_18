{
	char *p;
	int i;
        struct pktgen_dev *pkt_dev = (struct pktgen_dev*)(data);
        __u64 sa;
        __u64 stopped;
        __u64 now = getCurUs();
        
	p = buf;
	p += sprintf(p, "Params: count %llu  min_pkt_size: %u  max_pkt_size: %u\n",
		     (unsigned long long) pkt_dev->count,
		     pkt_dev->min_pkt_size, pkt_dev->max_pkt_size);

