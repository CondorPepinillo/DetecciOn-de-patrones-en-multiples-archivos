static int pppoe_seq_show(struct seq_file *seq, void *v)
{
	struct pppox_opt *po;
	char *dev_name;

	if (v == SEQ_START_TOKEN) {
		seq_puts(seq, "Id       Address              Device\n");
		goto out;
