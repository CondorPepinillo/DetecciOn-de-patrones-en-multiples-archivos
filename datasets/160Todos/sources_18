{
	struct platform_device *dev = to_platform_device(_dev);

	serial_pxa_ports[dev->id].port.dev = _dev;
	uart_add_one_port(&serial_pxa_reg, &serial_pxa_ports[dev->id].port);
	dev_set_drvdata(_dev, &serial_pxa_ports[dev->id]);
	return 0;
}

