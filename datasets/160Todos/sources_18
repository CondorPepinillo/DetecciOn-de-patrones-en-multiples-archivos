                PKT_ptr_ptr tx_end_ptr_ptr;
                PKT_ptr_ptr tx_add_ptr_ptr;
                PKT_ptr_ptr tx_remove_ptr_ptr;
            } s1;
            struct
            {
                ushort * tx_start_ptr;
                ushort * tx_end_ptr;
                ushort * tx_add_ptr;
                ushort * tx_remove_ptr;
            } s2;
        } u3;
