snd_nm256_init_chip(nm256_t *chip)
{
	spin_lock_irq(&chip->reg_lock);
	/* Reset everything. */
	snd_nm256_writeb(chip, 0x0, 0x11);
	snd_nm256_writew(chip, 0x214, 0);
