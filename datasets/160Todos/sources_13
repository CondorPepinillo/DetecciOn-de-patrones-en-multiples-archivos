#define LED_REGISTER 0xa6104d20

static void mach_led_d9(int value)
{
	unsigned long reg;
	reg = ctrl_inl(LED_REGISTER);
	reg &= ~1;
	reg |= (value & 1);
	ctrl_outl(reg, LED_REGISTER);
	return;
}

static void mach_led_d10(int value)
{
	unsigned long reg;
	reg = ctrl_inl(LED_REGISTER);
	reg &= ~2;
	reg |= ((value & 1) << 1);
	ctrl_outl(reg, LED_REGISTER);
	return;
}


