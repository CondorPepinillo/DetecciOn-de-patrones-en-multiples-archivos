static int _pcc_get_socket(u_short sock, socket_state_t *state)
{
//	pcc_socket_t *t = &socket[sock];

#if defined(CONFIG_PLAT_M32700UT) || defined(CONFIG_PLAT_USRV) || defined(CONFIG_PLAT_OPSPUT)
	state->flags = 0;
