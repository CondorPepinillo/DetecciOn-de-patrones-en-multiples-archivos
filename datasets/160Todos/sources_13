	{ HPHW_BA, HVERSION_REV_ANY_ID, HVERSION_ANY_ID, 0x00081 },
	{ 0, }
};

struct parisc_driver lasi_driver = {
	.name =		"Lasi",
	.id_table =	lasi_tbl,
	.probe =	lasi_init_chip,
};
