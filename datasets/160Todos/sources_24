  TAS3001C_REG_RIGHT_BIQUAD2          = 0x15,
  TAS3001C_REG_RIGHT_BIQUAD3          = 0x16,
  TAS3001C_REG_RIGHT_BIQUAD4          = 0x17,
  TAS3001C_REG_RIGHT_BIQUAD5          = 0x18,
  TAS3001C_REG_RIGHT_BIQUAD6          = 0x19,

