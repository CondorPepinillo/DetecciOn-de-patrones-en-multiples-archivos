struct tda10021_state {

	struct i2c_adapter* i2c;

	struct dvb_frontend_ops ops;

	/* configuration settings */
	const struct tda10021_config* config;

	struct dvb_frontend frontend;

	u8 pwm;
	u8 reg0;
};


#if 0
