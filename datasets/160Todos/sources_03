};

static int __init cfq_init(void)
{
	int ret;

	if (cfq_slab_setup())
		return -ENOMEM;

	ret = elv_register(&iosched_cfq);
	if (!ret) {
		__module_get(THIS_MODULE);
		return 0;
	}

	cfq_slab_kill();
	return ret;
}

static void __exit cfq_exit(void)
{
	cfq_slab_kill();
	elv_unregister(&iosched_cfq);
}

module_init(cfq_init);
module_exit(cfq_exit);

