	saa7146_setgpio(budget_av->budget.dev, 1, SAA7146_GPIO_OUTHI);
	result = ttpci_budget_debiwrite(&budget_av->budget, DEBICICAM, address & 0xfff, 1, value, 0, 0);

	if (result == -ETIMEDOUT)
