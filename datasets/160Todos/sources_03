	.get_last_session	= scd_get_last_session,
	.get_mcn		= scd_get_mcn,
	.reset			= scd_reset,
	.audio_ioctl		= scd_audio_ioctl,
	.dev_ioctl		= scd_dev_ioctl,
	.capability		= CDC_OPEN_TRAY | CDC_CLOSE_TRAY | CDC_LOCK |
				  CDC_SELECT_SPEED | CDC_MULTI_SESSION |
