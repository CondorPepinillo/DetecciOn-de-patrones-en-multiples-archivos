void print_booter(char *env)
{
	char *name;
	char *value;
	while(*env)
	{
		name=env;
		value=name;
		while(*value!='='&&*value)
			value++;
		if(*value=='=')
			*value++=0;
		env=value;
		while(*env)
			env++;
		env++;
		printk("%s=%s\n", name,value);
	}
 }




