{
	struct serial_struct serial_req;

	serial_req.flags      = UPF_AUTOPROBE | UPF_SHARE_IRQ;
	serial_req.baud_base  = BASE_BAUD;
	serial_req.irq        = irq;
	serial_req.io_type    = UPIO_MEM;
	serial_req.iomap_base = port;
	serial_req.iomem_base = ioremap(port, 0x10);
