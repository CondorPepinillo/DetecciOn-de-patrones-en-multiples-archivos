	 */
	union {
		uint8_t c;
		struct {
			uint8_t scsi_bus_1_control:2;
			uint8_t scsi_bus_0_control:2;
			uint8_t unused_0:1;
			uint8_t unused_1:1;
			uint8_t unused_2:1;
			uint8_t auto_term_support:1;
		} f;
	} termination;		/* 17 */

	uint16_t isp_parameter;	/* 18, 19 */

	union {
		uint16_t w;
		struct {
			uint16_t enable_fast_posting:1;
			uint16_t report_lvd_bus_transition:1;
			uint16_t unused_2:1;
			uint16_t unused_3:1;
