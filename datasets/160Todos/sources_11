	.tuple = { .src = { .u = { __constant_htons(SNMP_TRAP_PORT) } },
		   .dst = { .protonum = IPPROTO_UDP },
	},
	.mask = { .src = { .u = { 0xFFFF } },
		 .dst = { .protonum = 0xFF },
	},
};

