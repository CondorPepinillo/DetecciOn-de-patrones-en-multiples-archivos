static int __init ip2_init(void)
{
	if( poll_only ) {
		/* Hard lock the interrupts to zero */
		irq[0] = irq[1] = irq[2] = irq[3] = 0;
	}

	return ip2_loadmain(io,irq,(unsigned char *)fip_firm,sizeof(fip_firm));
}
