  friend class _Jv_BytecodeVerifier;
  friend class gnu::gcj::runtime::NameFinder;
  friend class gnu::gcj::runtime::StackTrace;
  friend class _Jv_InterpreterEngine;
  

#ifdef JV_MARKOBJ_DECL
  friend JV_MARKOBJ_DECL;
