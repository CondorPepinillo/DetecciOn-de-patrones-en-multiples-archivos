void
ia64_hpux_handle_builtin_pragma (cpp_reader *pfile ATTRIBUTE_UNUSED)
{
  /* #pragma builtin name, name, name */

  enum cpp_ttype type;
  tree x;

  type = c_lex (&x);
  while (type == CPP_NAME)
    {
      ia64_hpux_add_pragma_builtin (x);
      type = c_lex (&x);
      if (type == CPP_COMMA)
	type = c_lex (&x);
    }
  if (type != CPP_EOF)
    warning ("malformed #pragma builtin");
}

