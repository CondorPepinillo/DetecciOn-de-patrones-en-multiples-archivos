extern inline void 
_Jv_storeIndexes (_Jv_word *data,
		 _Jv_ushort index0,
		 _Jv_ushort index1)
{
  data->i = (((jint)index0) << 16) | (jint) index1;
}

extern inline void 
_Jv_loadIndexes (const _Jv_word *data,
		 _Jv_ushort& index0,
		 _Jv_ushort& index1)
{
  jint udata = data->i;
      
  _Jv_uint uindex0 = ((udata >> 16) & 0xffff);
  _Jv_uint uindex1 = udata & 0xffff;
      
  index0 = uindex0;
  index1 = uindex1;
}

